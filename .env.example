APP_ENV=dev                  # set prod on deploy (then AUTH_REQUIRED must be true)
AUTH_REQUIRED=false
SENSOR_INGEST_TOKEN=       # required to enable ESP32 ingestion; use a long random secret
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=        # service_role key: backend only, never in the browser / git
SUPABASE_ANON_KEY=           # public anon key: used only for login/register calls (Project Settings > API)
SIGNUP_ENABLED=true
XAI_API_KEY=                 # optional; without it the deterministic Bengali template is used
GROK_MODEL=grok-4            # check the current model name in your xAI console

# Section 2 extras (all optional)
SMS_PROVIDER=none            # none = simulated (events only) | webhook = POST {"to","text"} to SMS_WEBHOOK_URL
SMS_WEBHOOK_URL=
DISEASE_MIN_SCORE=0.70       # below this a photo result is "unknown"
DISEASE_REVIEW_SCORE=0.85    # a disease label below this also goes to expert review

TRUST_MIN_FARMERS=1          # Section 4 shows distributions only when at least this many different farmers finished the crop

# WhatsApp Cloud API (Meta) - all optional; empty = simulated (nothing is sent)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=       # any secret string; type the same one in Meta's webhook setup
WHATSAPP_APP_SECRET=         # Meta app secret (required in prod: webhook signature check)
WHATSAPP_NUMBER=             # business number farmers message, e.g. 8801XXXXXXXXX
WHATSAPP_ALERT_TEMPLATE=     # approved template name for alerts sent more than 24h after the farmer last wrote
CHANNEL_SECRET=              # shared secret for POST /messaging/sms/inbound (header X-Channel-Secret)
SMS_MAX_CHARS=200            # Bangla SMS = 67 chars per part, so 200 is about 3 parts
